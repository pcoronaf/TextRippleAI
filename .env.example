# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Leave DATABASE_URL unset to use the zero-install file store (JSON under .data/).
# Set it to use PostgreSQL; run `npm run db:migrate` once before first use.
# DATABASE_URL=postgres://textripple:textripple@localhost:5432/textripple

# Directory used by the file store when DATABASE_URL is unset.
# DATA_DIR=.data

# ---------------------------------------------------------------------------
# AI gateway (not called during M0-M1 editing - wired for M2 onwards)
# ---------------------------------------------------------------------------
# Which provider the gateway routes to: anthropic | openai | mock
AI_PROVIDER=mock

# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_FAST_MODEL=claude-haiku-4-5
# ANTHROPIC_REASONING_MODEL=claude-opus-5

# OPENAI_API_KEY=sk-...
# OPENAI_FAST_MODEL=gpt-4.1-mini
# OPENAI_REASONING_MODEL=gpt-4.1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
